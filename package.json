{
  "name": "yfbjj-funnel",
  "version": "1.0.0",
  "description": "welcome.yogaforbjj.net funnel Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run preflight && wrangler deploy",
    "preflight:staging:locked": "node scripts/preflight.mjs --locked-staging",
    "deploy:staging:locked": "npm run preflight:staging:locked && wrangler deploy --env staging",
    "preflight:staging:functional": "node scripts/preflight.mjs --functional-staging",
    "deploy:staging:functional": "npm run preflight:staging:functional && wrangler deploy --env staging",
    "scan": "bash scripts/scan-secrets.sh",
    "db:create": "wrangler d1 create yfbjj_funnel",
    "db:migrate:local": "wrangler d1 migrations apply yfbjj_funnel --local",
    "db:migrate:remote": "wrangler d1 migrations apply yfbjj_funnel --remote",
    "tail": "wrangler tail",
    "preflight": "node scripts/preflight.mjs",
    "test": "node --test",
    "dry-run:staging": "wrangler deploy --env staging --dry-run",
    "db:migrate:staging": "wrangler d1 migrations apply yfbjj_funnel_staging --env staging --remote",
    "build:tc": "node scripts/build-thrivecart.mjs",
    "build:img": "node scripts/build-images.mjs",
    "visual:audit": "node scripts/visual-audit.mjs",
    "triple-check:live": "node scripts/triple-check-live.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "playwright": "^1.55.1",
    "wrangler": "^4.124.0"
  },
  "private": true
}
